# Resend API Key
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_YOUR_API_KEY_HERE

# Optional: If you want to use a custom sending domain
# RESEND_FROM_EMAIL=contact@yourdomain.com
# RESEND_REPLY_TO_EMAIL=info@yourdomain.com

# Base URL of the Vercel Blob store holding the typographic map deep-zoom tiles.
# Without it the gallery still builds; the zoom viewers just report that the
# zoomable version isn't available. Upload tiles with:
#   node scripts/upload-typographic-tiles.js
NEXT_PUBLIC_TILE_BASE_URL=https://YOUR_STORE_ID.public.blob.vercel-storage.com
